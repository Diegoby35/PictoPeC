# Copia este fichero a .env y pega tu clave para activar la simplificación
# adaptativa. Sin clave, PictoPeC funciona igual con el diccionario local.
#
# La clave se saca gratis en Google AI Studio, sin tarjeta:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionales
# Nivel gratuito. gemini-3.1-flash-lite responde en ~2-4 s; los Flash grandes
# razonan mejor pero tardan más de 20 s, demasiado con alguien esperando.
# Para ver cuáles admite tu clave:  npm run ia -- --modelos
PICTOPEC_MODELO=gemini-3.1-flash-lite

# Razonamiento previo del modelo: vacío = lo decide él; 0 = desactivado (más rápido)
PICTOPEC_PENSAR=

PORT=3000
